{
  // Settings of the site as a Cloudflare Worker: the files of the build, and the two relays under /api/.
  "name": "datagovgr-ai-readiness",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // No logs and no traces of the Worker are kept: a request of the second reading carries the key of a visitor.
  "observability": {
    "enabled": false,
    "traces": {
      "enabled": false
    }
  }
}
