# Files that are not part of the repository

# Python virtual environment (recreated from requirements.txt)
.venv/
__pycache__/
*.pyc

# Credentials, e.g. API keys
.env

# Data files of the publishing organisations: they can be large and belong to them.
# Only their links, inside the metadata, are kept in the repository.
data/raw/resources/

# Test snapshots (runs with --limit) and temporary download files
data/raw/*_test*
*.part

# Run logs
*.log

# Working notes of the review of the automated checks (one Excel workbook per criterion) and the local file with a
# random sample of records of every dataset (06_file_checks.py): they hold records of the data, so they stay local.
# The confirmed scores are published in the assessment workbook.
review/

# Temporary lock files of Excel and Word, present while a file is open
~$*

# Files created by operating systems and code editors
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.ipynb_checkpoints/
